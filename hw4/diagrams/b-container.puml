@startuml BContainers
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
title Вариант B — устойчивые процессы Temporal
Person(user, "Пользователь", "Настройки и получение уведомлений")
Person(support, "Поддержка банка", "Проверка истории доставки")
System_Ext(bank, "Сервисы банка", "Стабильный source_event_id")
System_Ext(app, "Приложение банка", "Входящие по notification_id; ACK")
System_Ext(providers, "Push / SMS / email", "Отправка, статусы, callback")
System_Boundary(platform, "Notification Platform B") {
  Container(api, "Notification API", "Python / FastAPI", "Приём, настройки, статусы, ACK и callback")
  ContainerDb(db, "Platform DB", "PostgreSQL", "Уведомления, попытки, настройки, история, outbox; синхронная реплика")
  Container(relay, "Outbox Relay", "Python / Temporal SDK", "Повторяемый запуск workflow и передача signals из outbox")
  Container(temporal, "Temporal Service", "Temporal Server", "История выполнения, таймеры, отдельные critical и bulk task queues")
  ContainerDb(tdb, "Temporal DB", "PostgreSQL", "Служебная история процессов; синхронная реплика; отдельный кластер")
  Container(critical, "Critical Workers", "Python / Temporal SDK", "Workflow доставки и activities; адаптеры каналов внутри")
  Container(bulk, "Bulk Workers", "Python / Temporal SDK", "Сервисные и маркетинговые процессы; квоты")
  Container(monitor, "Мониторинг", "Prometheus / Alertmanager / Grafana", "Метрики API, процессов, доставки и стоимости")
}
Rel(user, app, "Читает и меняет настройки")
Rel(bank, api, "Уведомления / кампании", "HTTPS")
Rel(app, api, "Настройки / ACK", "HTTPS")
Rel(support, api, "История notification_id", "HTTPS")
Rel(api, db, "Уведомление + outbox либо evidence + outbox атомарно", "SQL")
Rel(relay, db, "Читает outbox; отмечает подтверждённую передачу", "SQL")
Rel(relay, temporal, "Start workflow / signal с постоянным ID", "gRPC")
Rel(temporal, tdb, "Хранит историю", "SQL")
Rel(critical, temporal, "Получает задачи; возвращает результаты", "gRPC")
Rel(bulk, temporal, "Получает bulk задачи", "gRPC")
Rel(critical, db, "Activities: dispatch guard, попытки, настройки, evidence", "SQL")
Rel(bulk, db, "Activities: настройки, попытки", "SQL")
Rel(critical, providers, "Отправка / сверка", "HTTPS")
Rel(bulk, providers, "Отправка / сверка", "HTTPS")
Rel(providers, app, "Push", "Push")
Rel(providers, user, "SMS / email")
Rel(providers, api, "Подтверждения", "HTTPS callback")
Rel(monitor, api, "Метрики", "HTTPS")
Rel(monitor, temporal, "Метрики", "HTTPS")
Rel(monitor, critical, "Метрики", "HTTPS")
Rel(monitor, bulk, "Метрики", "HTTPS")
Rel(monitor, support, "Оповещения")
SHOW_LEGEND()
@enduml
