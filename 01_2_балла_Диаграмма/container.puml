@startuml MarketplaceContainers
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Маркетплейс — C4 Container — целевая архитектура
Person(buyer, "Покупатель", "Лента, заказы и оплата")
Person(seller, "Продавец", "Управляет товарами")
System_Ext(psp, "Платёжный провайдер", "Hosted checkout, эквайринг и webhook")
System_Ext(provider, "Email / Push провайдер", "Доставка уведомлений")
System_Boundary(marketplace, "Маркетплейс") {
  Container(ui, "Web UI", "React / TypeScript", "Кабинет покупателя и продавца")
  Container(gateway, "API Gateway", "Nginx", "Маршрутизация; auth_request в Users; без бизнес-логики")
  Container(users, "Users Service", "Python", "Учётные записи, роли, контакты, предпочтения")
  Container(catalog, "Catalog Service", "Python", "Товары, цены, остатки, резервы, персональная лента")
  Container(orders, "Orders Service", "Python", "Заказы, снимки и оркестрация; реализован только /health")
  Container(payments, "Payments Service", "Python", "Расчёт и учёт платежей и возвратов, адаптер PSP")
  Container(notifications, "Notifications Service", "Python", "Отправка из очереди; без собственной БД")
  ContainerQueue(broker, "Event Broker", "RabbitMQ", "Очереди событий и команд; at least once")
  ContainerDb(usersdb, "Users DB", "PostgreSQL", "Профили и роли")
  ContainerDb(catalogdb, "Catalog DB", "PostgreSQL", "Товары и резервы")
  ContainerDb(ordersdb, "Orders DB", "PostgreSQL", "Заказы, снимки, outbox и inbox")
  ContainerDb(paymentsdb, "Payments DB", "PostgreSQL", "Суммы, попытки, outbox и inbox")
}
Rel(buyer, ui, "Использует", "HTTPS")
Rel(seller, ui, "Использует", "HTTPS")
Rel(ui, gateway, "API-запросы", "HTTPS/JSON, синхронно")
Rel(gateway, users, "Профиль, вход, проверка токена", "HTTPS/JSON, синхронно")
Rel(gateway, catalog, "Каталог, лента", "HTTPS/JSON, синхронно")
Rel(gateway, orders, "Создать заказ, получить статус и payment_url", "HTTPS/JSON, синхронно")
Rel(catalog, users, "Роль продавца, предпочтения", "HTTPS/JSON, синхронно")
Rel(orders, users, "Проверить покупателя", "HTTPS/JSON, синхронно")
Rel(orders, catalog, "Цена, создание / проверка / подтверждение / отмена резерва", "HTTPS/JSON, синхронно")
Rel(notifications, users, "Получить контакты", "HTTPS/JSON, синхронно")
Rel(users, usersdb, "Читает и пишет только свои данные", "SQL")
Rel(catalog, catalogdb, "Читает и пишет только свои данные", "SQL")
Rel(orders, ordersdb, "Читает и пишет только свои данные", "SQL")
Rel(payments, paymentsdb, "Читает и пишет только свои данные", "SQL")
Rel(orders, broker, "OrderPlaced, RefundRequested, OrderStatusChanged", "AMQP, асинхронно")
Rel(broker, payments, "OrderPlaced, RefundRequested", "AMQP, асинхронно")
Rel(payments, broker, "PaymentPending / Succeeded / Failed, RefundSucceeded", "AMQP, асинхронно")
Rel(broker, orders, "События оплаты / возврата", "AMQP, асинхронно")
Rel(broker, notifications, "OrderStatusChanged", "AMQP, асинхронно")
Rel(payments, psp, "Создать платёж / возврат", "HTTPS, синхронно")
Rel(psp, payments, "Подтверждение статуса", "HTTPS webhook, асинхронно")
Rel(ui, psp, "Переход на платёжную страницу", "HTTPS")
Rel(notifications, provider, "Отправить уведомление", "HTTPS, синхронно")
SHOW_LEGEND()
@enduml
